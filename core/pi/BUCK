    name = "pi",
    srcs = glob(["**/*.lua"], exclude = ["**/*_test.lua"]),
    prefix = "pi",
    visibility = ["PUBLIC"],
)

lua_test(
    name = "ai_test",
    src = "ai/ai_test.lua",
    deps = [":pi"],
)

